#!/bin/sh
set -eu
here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
if ! command -v node >/dev/null 2>&1; then
  echo "node staat niet op het PATH." >&2
  exit 1
fi
major=$(node -p "process.versions.node.split('.')[0]")
if [ "$major" -lt 22 ]; then
  echo "Node 22 of nieuwer is nodig voor een preview." >&2
  exit 1
fi
exec node "$here/preview-cli.js" up "$@"
