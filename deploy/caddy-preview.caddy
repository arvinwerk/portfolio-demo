# Eenmalig op de bestaande proxy. Vervang de hostnaam door PREVIEW_DOMAIN.
# Een wildcard-certificaat (DNS-01) hoort bij *.preview.example.nl.
# De preview-router op 127.0.0.1:3080 kiest de tak en mag /api/chat niet bufferen.

*.preview.example.nl {
	reverse_proxy 127.0.0.1:3080 {
		flush_interval -1
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
