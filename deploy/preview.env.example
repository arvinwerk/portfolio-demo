# Eenmalig op de VM: ~/.config/portfolio/preview.env
# chmod 600 ~/.config/portfolio/preview.env
#
# Hostnaam zonder schema. De tak feature/filter wordt https://feature-filter.preview.example.nl
PREVIEW_DOMAIN=preview.example.nl

# Verplicht zodra AI_API_KEY gezet is. De browser vraagt om deze gebruiker en dit wachtwoord.
PREVIEW_BASIC_AUTH=bezoeker:kies-een-wachtwoord

AI_MODEL=[REDACTED]
AI_API_KEY=

# Zelfde map als productie. Weglaten gebruikt de demo in het archief.
# CONTENT_DIR=/var/lib/portfolio/content

# PREVIEW_MAX=5
# PREVIEW_ROUTER_PORT=3080
