# Eenmalig op de VM: ~/.config/portfolio/development.env
# chmod 600 ~/.config/portfolio/development.env
#
# Hostnaam zonder schema. De proxy stuurt die naam naar 127.0.0.1:3001.
DEVELOPMENT_DOMAIN=development.example.nl

AI_MODEL=[REDACTED]
AI_API_KEY=

# Zelfde map als productie. Weglaten gebruikt de demo in het archief.
# CONTENT_DIR=/var/lib/portfolio/content

# PORT=3001
