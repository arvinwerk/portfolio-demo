# Lokaal Qwen-model uit qwen/Modelfile. `pnpm qwen` laat Ollama het model laden.
AI_MODEL=qwen
AI_BASE_URL=http://127.0.0.1:11434/v1
# Ondertekent het gesprek. Gaat niet naar het model. Zet hier een eigen geheim.
AI_API_KEY=
# Absoluut pad naar de echte content, buiten de repo. Zonder deze variabele geldt content/ in de checkout.
# CONTENT_DIR=
# Zet dit alleen als één bestand geïndexeerd moet worden. Anders telt elk tekstbestand in content/rag.
# RAG_DOCUMENT_PATH=profile.txt
