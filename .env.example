# Zet de chat aan. Het model antwoordt vanuit content/rag/recruiter.txt.
AI_MODEL=qwen
# Lokaal adres van het model. De chat stuurt het gesprek hierheen.
AI_BASE_URL=http://127.0.0.1:11434/v1
# Ondertekent het gesprek. Gaat niet mee naar het model. Zet hier een eigen geheim.
AI_API_KEY=
# Absoluut pad naar de echte content, buiten de repo. Zonder deze variabele geldt content/ in de checkout.
# CONTENT_DIR=
# Eén tekstbestand per gesprek. Zonder deze variabele: CONTENT_DIR/chat, of data/chat.
# CHAT_LOG_DIR=
# Zet dit alleen als één bestand geïndexeerd moet worden. Anders telt elk tekstbestand in content/rag.
# RAG_DOCUMENT_PATH=profile.txt
